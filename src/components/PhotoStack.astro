---
interface Photo {
  src: string;
  alt: string;
  orientation?: 'portrait' | 'landscape';
}

interface Props {
  photos: Photo[];
  caption?: string;
}

const { photos, caption } = Astro.props;
---

<figure class="photo-stack" data-reveal-item>
  <button
    type="button"
    class="photo-stack__stage"
    data-photo-stack
    aria-label="Click to see the next photo"
  >
    {photos.map((photo, index) => (
      <div class="photo-stack__item" data-stack-index={index} data-orientation={photo.orientation ?? 'portrait'}>
        <img class="photo-stack__photo" src={photo.src} alt={photo.alt} loading="lazy" />
      </div>
    ))}
  </button>
  {caption && <figcaption class="photo-stack__caption">{caption}</figcaption>}
</figure>
