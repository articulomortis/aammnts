---
interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="inline-image">
  <div class="inline-image__inner">
    <div class="product-map" data-product-map></div>
    {caption && <figcaption class="inline-image__caption">{caption}</figcaption>}
  </div>
</figure>

<script>
  import { mountProductMap } from '../scripts/product-map';

  let cleanup: (() => void) | undefined;

  function boot() {
    const container = document.querySelector<HTMLElement>('[data-product-map]');
    if (!container) return;
    cleanup?.();
    cleanup = mountProductMap(container);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
