---
interface Frame {
  src: string;
  alt: string;
  caption?: string;
  previewBackground: string;
}

interface Props {
  frames: readonly [Frame, Frame, ...Frame[]];
  width: number;
  height: number;
  hint?: string;
}

const { frames, width, height, hint = 'Click to compare' } = Astro.props;
const hasCaptions = frames.some((frame) => frame.caption);
---

<div class="compare-image" data-reveal-item>
  <figure
    class="compare-image__panel"
    style={{ '--compare-image-aspect': `${width} / ${height}` }}
  >
    <div class="image-previews" role="group" aria-label="Screenshot previews">
      {frames.map((frame, index) => (
        <button
          type="button"
          class="image-preview"
          style={{ '--image-preview-background': frame.previewBackground }}
          data-compare-preview={index}
          aria-label={frame.alt}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <img src={frame.src} alt="" loading="lazy" />
        </button>
      ))}
    </div>
    <button type="button" class="compare-image__stage" data-compare-image aria-label={hint}>
      {frames.map((frame, index) => (
        <img
          class:list={['compare-image__frame', { 'is-active': index === 0 }]}
          data-compare-frame={index}
          src={frame.src}
          alt={frame.alt}
          loading="lazy"
        />
      ))}
    </button>
    {hasCaptions && (
      <figcaption class="compare-image__caption">
        {frames.map((frame, index) => (
          <span
            class:list={['compare-image__caption-text', { 'is-active': index === 0 }]}
            data-compare-caption={index}
          >{frame.caption}</span>
        ))}
      </figcaption>
    )}
  </figure>
</div>
