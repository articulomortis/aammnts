---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineImage from '../../components/InlineImage.astro';
import PhotoStack from '../../components/PhotoStack.astro';
import CompareImage from '../../components/CompareImage.astro';
import { detailsIntro, detailsSections, site } from '../../content/site';
---

<BaseLayout
  title={`Yandex Go — ${site.name}`}
  description="Longread about design work at Yandex Go."
>
  <main class="page-main page-main--offset text-block">
    <article class="content-container" data-reveal-container="load">
      <p class="details-section__paragraph" data-reveal-item>
        {detailsIntro}
      </p>

      {
        detailsSections.map((section) => (
          <section class="details-section" id={section.id}>
            {section.title ? (
              <h2 class="details-section__title" data-reveal-item>
                {section.title}
              </h2>
            ) : null}
            {section.paragraphs.map((paragraph, paragraphIndex) => (
              <>
                <p class="details-section__paragraph" data-reveal-item>
                  {paragraph}
                </p>
                {section.id === 'about-the-project' && paragraphIndex === 0 && (
                  <InlineImage
                    src="/images/details/fleet-product-map.svg"
                    alt="Fleet product map: navigation tree with Home, Drivers, Vehicles, Reports, Map, Products and services, Information, Settings"
                    caption="Fleet product map, 2019. Each branch had grown almost independently over time"
                  />
                )}
                {section.id === 'about-the-project' && paragraphIndex === 1 && (
                  <InlineImage
                    class="inline-image--small"
                    src="/images/details/raw-tables.svg"
                    alt="Raw table view representing the product's single layer of interpretation"
                    caption="The product offered only one layer of interpretation — raw tables"
                  />
                )}
                {section.id === 'rebuilding-the-product' && paragraphIndex === 2 && (
                  <InlineImage
                    src="/images/details/driver-lifecycle.svg"
                    alt="Driver lifecycle diagram: Candidate, Active, Churned, and Archived statuses with the transitions between them"
                    caption="The driver's lifecycle in the service"
                  />
                )}
                {section.id === 'rebuilding-the-product' && paragraphIndex === 5 && (
                  <CompareImage
                    before={{
                      src: '/images/details/drivers-old.png',
                      alt: 'The old Drivers page: an endless raw data table with countless filters',
                      caption: 'An endless table with raw data. Partners had to interpret problems on their own',
                    }}
                    after={{
                      src: '/images/details/drivers-new.png',
                      alt: 'The new Drivers page: lifecycle statuses and warning indicators surfaced at the top',
                      caption: 'We added the driver lifecycle and made problems visible, helping partners act earlier.\nThis had an immediate effect on supply hours',
                    }}
                  />
                )}
                {section.id === 'what-we-built-next' && paragraphIndex === 1 && (
                  <CompareImage
                    before={{
                      src: '/images/details/vehicles-overview.png',
                      alt: 'Vehicles dashboard: aggregated insights into fleet performance',
                      caption: 'A new layer of aggregated insights helped partners understand fleet performance at a glance',
                    }}
                    after={{
                      src: '/images/details/vehicles-expenses.png',
                      alt: 'Vehicle expenses view: rental status, repairs, and operational changes in one place',
                      caption: 'From overview to action: partners could manage vehicle expenses, rental status,\nrepairs, and operational changes in one place',
                    }}
                  />
                )}
                {section.id === 'what-we-built-next' && paragraphIndex === 2 && (
                  <InlineImage
                    class="inline-image--compare"
                    src="/images/details/home-dashboard.png"
                    alt="Home Page dashboard bringing together key signals, business health, and next actions"
                    caption="The Home Page brought key signals, business health, and next actions into one place"
                  />
                )}
                {section.id === 'rebuilding-the-product' && paragraphIndex === 0 && (
                  <PhotoStack
                    photos={[
                      { src: '/images/details/field-research-1.png', alt: 'Yango-branded car in the field during research', orientation: 'portrait' },
                      { src: '/images/details/field-research-2.png', alt: 'Presenting onboarding materials to a classroom of partners', orientation: 'landscape' },
                      { src: '/images/details/field-research-3.png', alt: 'Whiteboard sketch of the CRM and driver journey', orientation: 'landscape' },
                      { src: '/images/details/field-research-4.png', alt: 'Reviewing research notes with a local partner', orientation: 'landscape' },
                      { src: '/images/details/field-research-5.png', alt: 'Walking a partner through a dashboard on screen', orientation: 'portrait' },
                      { src: '/images/details/field-research-6.png', alt: 'Devices and interview printouts laid out on a desk', orientation: 'portrait' },
                      { src: '/images/details/field-research-7.png', alt: 'Reviewing a spreadsheet together with a partner', orientation: 'landscape' },
                    ]}
                    caption="Photos from field research in Angola, Namibia and Zambia"
                  />
                )}
              </>
            ))}
          </section>
        ))
      }

      <a class="details-back link" href="/" data-astro-prefetch data-reveal-item>
        <span aria-hidden="true">←</span>
        Back
      </a>
    </article>
  </main>
</BaseLayout>
